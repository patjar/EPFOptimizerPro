<Window x:Class="EPFOptimizerPro.AiCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre IA - EPF Optimizer Pro" Height="720" Width="980"
        WindowStartupLocation="CenterOwner" Background="#020617" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111827"/>
        <SolidColorBrush x:Key="BorderPremium" Color="#26364F"/>
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Sky" Color="#38BDF8"/>
        <SolidColorBrush x:Key="Green" Color="#22C55E"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderPremium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
    
    <!-- EPFOptimizerPro - Styles boutons Fluent premium -->
    <Style x:Key="EpfoButtonBaseStyle" TargetType="Button">
        <Setter Property="Width" Value="168"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,5,0,8"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="BorderBrush" Value="#1D4ED8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </Grid.RenderTransform>

                        <Border x:Name="Shadow"
                                Margin="0,2,0,0"
                                CornerRadius="14"
                                Background="#01000000">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A"
                                                  BlurRadius="16"
                                                  ShadowDepth="4"
                                                  Opacity="0.20"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Grid ClipToBounds="True">
                                <Border CornerRadius="14"
                                        Opacity="0.42">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#66FFFFFF" Offset="0.00"/>
                                            <GradientStop Color="#18FFFFFF" Offset="0.45"/>
                                            <GradientStop Color="#00000000" Offset="1.00"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border Height="1"
                                        VerticalAlignment="Top"
                                        Margin="14,1,14,0"
                                        Background="#80FFFFFF"/>

                                <Border Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="#22000000"/>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="0" Y="-1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Shadow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0F172A"
                                                      BlurRadius="22"
                                                      ShadowDepth="6"
                                                      Opacity="0.26"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Surface" Property="Opacity" Value="0.98"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="0" Y="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Shadow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0F172A"
                                                      BlurRadius="8"
                                                      ShadowDepth="2"
                                                      Opacity="0.18"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Surface" Property="Opacity" Value="0.90"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#98A2B3"/>
                            <Setter TargetName="Surface" Property="Background" Value="#EEF2F7"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#D7DEE8"/>
                            <Setter TargetName="Shadow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0F172A"
                                                      BlurRadius="8"
                                                      ShadowDepth="2"
                                                      Opacity="0.08"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EpfoPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2DD4FF" Offset="0"/>
                    <GradientStop Color="#0EA5E9" Offset="0.42"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#38BDF8"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="EpfoSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#34D399" Offset="0"/>
                    <GradientStop Color="#22C55E" Offset="0.50"/>
                    <GradientStop Color="#16A34A" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#4ADE80"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="EpfoWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FBBF24" Offset="0"/>
                    <GradientStop Color="#F59E0B" Offset="0.50"/>
                    <GradientStop Color="#EA580C" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#FDBA74"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="EpfoSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F6FAFF" Offset="0.45"/>
                    <GradientStop Color="#EAF3FF" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#8EC5FF"/>
        <Setter Property="Foreground" Value="#2563EB"/>
    </Style>

    <Style x:Key="EpfoNeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8FAFC" Offset="0.50"/>
                    <GradientStop Color="#E5EAF1" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="Foreground" Value="#475569"/>
    </Style>
</Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Centre IA" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Sky}"/>
                <TextBlock Text="Pilotage local de la mémoire IA, de l'historique des scores et des fichiers d'apprentissage." Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Synthèse IA" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Sky}" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtSummary" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="#050A16" Foreground="#E5E7EB" BorderBrush="#26364F" FontFamily="Consolas" Padding="12"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Actions" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Sky}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="Rafraîchir" MinWidth="120" Click="BtnRefresh_Click"/>
                            <Button Content="Ouvrir dossier" MinWidth="130" Click="BtnOpenFolder_Click"/>
                            <Button Content="Historique IA" MinWidth="130" Click="BtnOpenHistory_Click"/>
                            <Button Content="Learning" MinWidth="120" Click="BtnOpenLearning_Click"/>
                            <Button Content="Résumé" MinWidth="120" Click="BtnOpenSummary_Click"/>
                            <Button Content="Réinitialiser historique" MinWidth="180" Background="#DC2626" BorderBrush="#F87171" Click="BtnResetHistory_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Fichiers mémoire" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Sky}" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtFiles" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="#050A16" Foreground="#E5E7EB" BorderBrush="#26364F" FontFamily="Consolas" Padding="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Fermer" MinWidth="120" Click="BtnClose_Click" Style="{StaticResource EpfoNeutralButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
