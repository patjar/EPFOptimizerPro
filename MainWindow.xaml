<Window x:Class="EPFOptimizerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EPF Optimizer Pro Premium IA v3.9.37" Height="940" Width="1320" MinHeight="860" MinWidth="1180"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F8FBFF" FontFamily="Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#020617" Offset="0"/>
            <GradientStop Color="#0F172A" Offset="0.55"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextMain" Color="#111827"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="Sky" Color="#0078D4"/>
        <SolidColorBrush x:Key="Green" Color="#16A34A"/>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderPremium" Color="#D7DEE8"/>
        <SolidColorBrush x:Key="ButtonIdle" Color="#2563EB"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderPremium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.24" Color="#000000"/></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Background" Value="{StaticResource ButtonIdle}"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="15" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.70"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Foreground" Value="#22C55E"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#050A16"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#26364F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    
    <!-- EPFOptimizerPro - Styles boutons Fluent premium -->
    <Style x:Key="EpfoButtonBaseStyle" TargetType="Button">
        <Setter Property="Width" Value="168"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,5,0,8"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="BorderBrush" Value="#1D4ED8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </Grid.RenderTransform>

                        <Border x:Name="Shadow"
                                Margin="0,2,0,0"
                                CornerRadius="14"
                                Background="#01000000">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A"
                                                  BlurRadius="16"
                                                  ShadowDepth="4"
                                                  Opacity="0.20"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Grid ClipToBounds="True">
                                <Border CornerRadius="14"
                                        Opacity="0.42">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#66FFFFFF" Offset="0.00"/>
                                            <GradientStop Color="#18FFFFFF" Offset="0.45"/>
                                            <GradientStop Color="#00000000" Offset="1.00"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border Height="1"
                                        VerticalAlignment="Top"
                                        Margin="14,1,14,0"
                                        Background="#80FFFFFF"/>

                                <Border Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="#22000000"/>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="0" Y="-1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Shadow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0F172A"
                                                      BlurRadius="22"
                                                      ShadowDepth="6"
                                                      Opacity="0.26"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Surface" Property="Opacity" Value="0.98"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="0" Y="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Shadow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0F172A"
                                                      BlurRadius="8"
                                                      ShadowDepth="2"
                                                      Opacity="0.18"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Surface" Property="Opacity" Value="0.90"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#98A2B3"/>
                            <Setter TargetName="Surface" Property="Background" Value="#EEF2F7"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#D7DEE8"/>
                            <Setter TargetName="Shadow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0F172A"
                                                      BlurRadius="8"
                                                      ShadowDepth="2"
                                                      Opacity="0.08"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EpfoPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2DD4FF" Offset="0"/>
                    <GradientStop Color="#0EA5E9" Offset="0.42"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#38BDF8"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="EpfoSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#34D399" Offset="0"/>
                    <GradientStop Color="#22C55E" Offset="0.50"/>
                    <GradientStop Color="#16A34A" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#4ADE80"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="EpfoWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FBBF24" Offset="0"/>
                    <GradientStop Color="#F59E0B" Offset="0.50"/>
                    <GradientStop Color="#EA580C" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#FDBA74"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="EpfoSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F6FAFF" Offset="0.45"/>
                    <GradientStop Color="#EAF3FF" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#8EC5FF"/>
        <Setter Property="Foreground" Value="#2563EB"/>
    </Style>

    <Style x:Key="EpfoNeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource EpfoButtonBaseStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8FAFC" Offset="0.50"/>
                    <GradientStop Color="#E5EAF1" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="Foreground" Value="#475569"/>
    </Style>
    <!-- EPFOptimizerPro - Theme Fluent Safe -->
    <SolidColorBrush x:Key="EpfoInkBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="EpfoMutedBrush" Color="#53627A"/>
    <SolidColorBrush x:Key="EpfoPanelBorderBrush" Color="#D8E6F5"/>
    <SolidColorBrush x:Key="EpfoProgressTrackBrush" Color="#E5EEF8"/>

    <LinearGradientBrush x:Key="EpfoCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFF9FCFF" Offset="0.58"/>
        <GradientStop Color="#FFF2F7FC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EpfoHeaderCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFF7FBFF" Offset="0.55"/>
        <GradientStop Color="#FFEAF6FF" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="EpfoDashboardCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EpfoCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource EpfoPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="4" Opacity="0.10"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EpfoHeaderCardStyle" TargetType="Border" BasedOn="{StaticResource EpfoDashboardCardStyle}">
        <Setter Property="Background" Value="{StaticResource EpfoHeaderCardBrush}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#0EA5E9" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EpfoMetricCardStyle" TargetType="Border" BasedOn="{StaticResource EpfoDashboardCardStyle}">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="4" Opacity="0.11"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EpfoSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource EpfoInkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="EpfoMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource EpfoMutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="EpfoProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Foreground" Value="#22C55E"/>
        <Setter Property="Background" Value="{StaticResource EpfoProgressTrackBrush}"/>
        <Setter Property="BorderBrush" Value="#D7E5F4"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</Window.Resources>
    <ScrollViewer x:Name="MainRootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">

    <Grid Background="{StaticResource PageGradient}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="235"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EPF Optimizer Pro" FontSize="15" Foreground="{StaticResource Sky}" FontWeight="SemiBold"/>
                    <TextBlock Text="Tableau de bord" FontSize="34" FontWeight="Bold" Margin="0,2,0,4"/>
                    <TextBlock Text="Vue synthétique : état du poste, diagnostics, IA locale et actions rapides." Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
                <Grid Grid.Column="1" HorizontalAlignment="Right" Width="390">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                    <Border Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource EpfoMetricCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtScoreHero" Text="100" FontSize="32" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center"/>
                            <TextBlock Text="/100" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtClock" Text="◐ 00:00:00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Sky}"/>
                        <TextBlock x:Name="TxtMetrics" Text="CPU -- % | RAM -- %" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtEvents" Text="0 événement" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="TxtWorkers" Text="Workers : --" Foreground="{StaticResource Green}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUpdateStatus" Text="Mise à jour : non vérifiée" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtAdminStatus" Text="Admin : --" Foreground="#DC2626" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TxtStep" Text="Conseil IA du démarrage" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="Commencez par un audit pour analyser le poste, puis utilisez Optimiser pour appliquer les corrections." Foreground="#475569" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtPercent" Grid.Column="1" Text="0 %" FontSize="16" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <ProgressBar Grid.Row="1" x:Name="ProgressGlobal" Minimum="0" Maximum="100" Value="0" Margin="0,14,0,14" Style="{StaticResource EpfoProgressBarStyle}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Actions principales" Margin="0,0,0,6" Style="{StaticResource EpfoSectionTitleStyle}"/>
                            <WrapPanel>
                                <Button x:Name="BtnAudit" Content="🔎 Audit seul" MinWidth="142" Click="BtnAudit_Click" Style="{StaticResource EpfoPrimaryButtonStyle}"/>
                                <Button x:Name="BtnOptimize" Content="⚙ Optimiser" MinWidth="142" Click="BtnOptimize_Click" Style="{StaticResource EpfoSuccessButtonStyle}"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Outils" Margin="0,0,0,6" Style="{StaticResource EpfoSectionTitleStyle}"/>
                            <WrapPanel>
                                <Button x:Name="BtnOpenReport" Content="Rapport" MinWidth="126" Click="BtnOpenReport_Click" Style="{StaticResource EpfoSecondaryButtonStyle}"/>
                                <Button x:Name="BtnOpenLearning" Content="Centre IA" MinWidth="126" Click="BtnOpenLearning_Click" Style="{StaticResource EpfoSecondaryButtonStyle}"/>
                                <Button x:Name="BtnCheckUpdate" Content="Mise à jour" MinWidth="126" Click="BtnCheckUpdate_Click"/>
                                <Button x:Name="BtnDownloadUpdate" Content="Télécharger update" MinWidth="150" Click="BtnDownloadUpdate_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Système" Foreground="#334155" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <Button x:Name="BtnCancel" Content="Annuler" MinWidth="118" Click="BtnCancel_Click" Style="{StaticResource EpfoWarningButtonStyle}"/>
                                <Button x:Name="BtnOpenUpdateRelease" Content="Release GitHub" MinWidth="138" Click="BtnOpenUpdateRelease_Click" Style="{StaticResource EpfoSecondaryButtonStyle}"/>
                                <Button x:Name="BtnExit" Content="Fermer" MinWidth="110" Click="BtnExit_Click" Style="{StaticResource EpfoNeutralButtonStyle}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="TxtActionHint" Text="Conseil : lancez 🔎 Audit seul pour analyser le poste, ou ⚙ Optimiser pour corriger automatiquement." Foreground="#475569" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <UniformGrid Grid.Column="1" Rows="2" Columns="2" Margin="0" VerticalAlignment="Stretch">
                <Border Style="{StaticResource Card}" Margin="0,0,10,10" MaxHeight="136">
                    <StackPanel>
                        <TextBlock Text="CPU" Foreground="#64748B" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="TxtCpuCard" Text="-- %" FontSize="22" FontWeight="Bold" Foreground="#0078D4" Margin="0,2,0,4"/>
                        <ProgressBar x:Name="ProgressCpuMini" Minimum="0" Maximum="100" Value="0" Style="{StaticResource EpfoProgressBarStyle}"/>
                        <TextBlock Text="Charge actuelle" Foreground="#475569" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10" MaxHeight="136">
                    <StackPanel>
                        <TextBlock Text="RAM" Foreground="#64748B" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="TxtRamCard" Text="-- %" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,4"/>
                        <ProgressBar x:Name="ProgressRamMini" Minimum="0" Maximum="100" Value="0" Style="{StaticResource EpfoProgressBarStyle}"/>
                        <TextBlock Text="Mémoire utilisée" Foreground="#475569" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,10,0" MaxHeight="136">
                    <StackPanel>
                        <TextBlock Text="Fichiers" Foreground="#64748B" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="TxtFilesCard" Text="--" FontSize="20" FontWeight="Bold" Foreground="#0F3B7A" Margin="0,2,0,4"/>
                        <ProgressBar x:Name="ProgressFilesMini" Minimum="0" Maximum="100" Value="0" Style="{StaticResource EpfoProgressBarStyle}"/>
                        <TextBlock Text="Fichiers / handles ouverts" Foreground="#475569" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0" MaxHeight="136">
                    <StackPanel>
                        <TextBlock Text="Services" Foreground="#64748B" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="TxtServicesCard" Text="-- / --" FontSize="20" FontWeight="Bold" Foreground="#0F3B7A" Margin="0,2,0,4"/>
                        <ProgressBar x:Name="ProgressServicesMini" Minimum="0" Maximum="100" Value="0" Style="{StaticResource EpfoProgressBarStyle}"/>
                        <TextBlock Text="Services actifs / repos" Foreground="#475569" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Tâches actives" FontSize="22" FontWeight="Bold" Foreground="#0078D4"/>
                    <TextBlock x:Name="TxtDashboardSummary" Text="  |  aucune tâche active" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="12,6,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#D6E2F0" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Terminées" Foreground="#334155" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <ItemsControl x:Name="CompletedTasksItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="46" Height="46" CornerRadius="23" Background="#FFFFFF" BorderBrush="#0F3B7A" BorderThickness="2" Margin="0,0,10,0">
                                        <Border.ToolTip>
                                            <StackPanel MaxWidth="280">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Status}"/>
                                                <TextBlock Text="{Binding Progress, StringFormat=Progression : {0}%}"/>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border.ToolTip>
                                        <Grid>
                                            <TextBlock Text="{Binding Icon}" FontSize="22" FontWeight="Bold" Foreground="#0F3B7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Grid>
                    <TextBlock x:Name="TxtNoActiveTasks" Text="Aucune tâche active. Lancez Audit seul pour analyser le poste, ou Optimiser pour appliquer les corrections." Foreground="#64748B" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ActiveTasksItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#D6E2F0" BorderThickness="1" CornerRadius="16" Width="250" Height="104" Padding="10" Margin="0,0,10,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="58"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#111827"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" Foreground="#0078D4" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Status}" Foreground="#0078D4" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Style="{StaticResource EpfoProgressBarStyle}"/>
                                            <TextBlock Text="{Binding Message}" Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" Height="24"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Assistant IA local" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Sky}"/>
                        <TextBlock Text="Tableau de bord IA, scores et recommandations." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="TxtAiHeadline" Text="Santé IA : en attente" FontSize="20" FontWeight="Bold" Foreground="#0078D4"/>
                                <TextBlock x:Name="TxtAiSubScore" Text="Perf -- | Sécu -- | Stockage -- | Update -- | Stabilité --" Foreground="#64748B" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtAiAdvice" Text="Lance un audit ou une optimisation pour générer une synthèse IA." Foreground="#111827" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    <TextBox x:Name="TxtAi" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="12" MinHeight="170"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Journal temps réel" Foreground="{StaticResource Sky}" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>




